# Errand.markets — environment variables
# Copy to .env.local for local development. NEVER commit real values.
# Market-specific secrets are suffixed with the ISO 3166 market code (_NG, _VC).
# See docs/architecture/06-external-accounts.md for where each value comes from.

# ── App ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
FIELD_ENCRYPTION_KEY=            # 32-byte base64; encrypts bank account numbers
ID_HASH_PEPPER=                  # 32-byte base64; HMAC pepper for KYC ID-number hashes

# ── Supabase (region eu-west-2) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUTH_SMS_HOOK_SECRET=   # verifies Supabase Send-SMS hook calls
# One connection string per data region (markets.data_region)
DATABASE_URL_EU_WEST_2=

# ── Inngest ─────────────────────────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Google Maps Platform (shared) ───────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=   # referrer-restricted
GOOGLE_MAPS_SERVER_KEY=                # API-restricted

# ── Web Push ────────────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@errand.markets

# ── Provider mode per market: sandbox | live ────────────────────────
PROVIDER_MODE_NG=sandbox
PROVIDER_MODE_VC=sandbox

# ── Nigeria (NG) ────────────────────────────────────────────────────
# Paystack — collection + Transfers (secret key also verifies webhooks)
PAYSTACK_PUBLIC_KEY_NG=
PAYSTACK_SECRET_KEY_NG=
# Dojah — NIN + selfie liveness
DOJAH_APP_ID_NG=
DOJAH_SECRET_KEY_NG=
DOJAH_PUBLIC_KEY_NG=
DOJAH_WIDGET_ID_NG=
DOJAH_WEBHOOK_SECRET_NG=
# Termii — OTP + SMS
TERMII_API_KEY_NG=
TERMII_SENDER_ID_NG=

# ── Saint Vincent & the Grenadines (VC) ─────────────────────────────
# Scotiabank ECom+ — hosted payment page (exact fields TBC from Scotiabank docs)
SCOTIA_ECOM_API_BASE_VC=
SCOTIA_ECOM_MERCHANT_ID_VC=
SCOTIA_ECOM_KEY_VC=
SCOTIA_ECOM_WEBHOOK_SECRET_VC=
# Bank batch payouts
PAYOUT_BATCH_FORMAT_VC=          # e.g. scotia_bulk_v1 (pending bank file spec)
PAYOUT_ORIGIN_ACCOUNT_VC=
# Sumsub — ID document + liveness
SUMSUB_APP_TOKEN_VC=
SUMSUB_SECRET_KEY_VC=
SUMSUB_WEBHOOK_SECRET_VC=
SUMSUB_LEVEL_NAME_VC=
# Twilio — SMS (Messaging Service for Option A, or Verify for Option B)
TWILIO_ACCOUNT_SID_VC=
TWILIO_AUTH_TOKEN_VC=
TWILIO_MESSAGING_SERVICE_SID_VC=
TWILIO_VERIFY_SERVICE_SID_VC=

# ── Optional ────────────────────────────────────────────────────────
SENTRY_DSN=
