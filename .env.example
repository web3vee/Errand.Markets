# Errand.markets — environment variables
# Copy to .env.local for local development. NEVER commit real values.
# Market-specific secrets are suffixed with the ISO 3166 market code (_NG, _VC).
# See docs/architecture/06-external-accounts.md for where each value comes from.

# ── App ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_SECRET=                      # ≥32 random chars; signs short-lived flow cookies (OTP step)
FIELD_ENCRYPTION_KEY=            # 32-byte base64; encrypts bank account numbers (Stage 6)
ID_HASH_PEPPER=                  # ≥32 random chars; HMAC pepper for KYC ID-number hashes (never rotate casually)

# ── Auth ────────────────────────────────────────────────────────────
# supabase = production (Supabase Auth + Send-SMS hook). local = sandbox sign-in for dev/test;
# refused on production deploys. Defaults to supabase when NEXT_PUBLIC_SUPABASE_URL is set.
AUTH_MODE=local
LOCAL_AUTH_SECRET=               # ≥32 chars; only for AUTH_MODE=local
SANDBOX_WEBHOOK_SECRET=          # signs sandbox KYC webhooks; only used in sandbox provider mode

# ── Supabase (region eu-west-2) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUTH_SMS_HOOK_SECRET=   # verifies Supabase Send-SMS hook calls
# One connection string per data region (markets.data_region). Use the pooler URL on Vercel.
# Local dev: postgres://errand:errand@localhost:5432/errand_dev (see README)
DATABASE_URL_EU_WEST_2=
DEFAULT_DATA_REGION=eu-west-2

# ── Inngest (background jobs) ───────────────────────────────────────
# Unset = jobs run in-process right after the response (local/sandbox only).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
CRON_SECRET=                     # ≥32 chars; protects /api/cron/sweep (Vercel Cron backstop for the expiry sweeper)

# ── Storage (images) ────────────────────────────────────────────────
# With Supabase configured: private bucket STORAGE_BUCKET. Otherwise local disk (sandbox; refused in production).
STORAGE_BUCKET=media
STORAGE_MODE=                    # set to "local" to force local disk in development
LOCAL_STORAGE_DIR=               # default ./.data/uploads

# ── Google Maps Platform (shared) ───────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=   # referrer-restricted
GOOGLE_MAPS_SERVER_KEY=                # API-restricted

# ── Web Push (generate once: npx web-push generate-vapid-keys) ──────
# Unset = push is recorded in the sandbox outbox instead of sent (refused in production).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@errand.markets

# ── Provider mode per market: sandbox | live ────────────────────────
PROVIDER_MODE_NG=sandbox
PROVIDER_MODE_VC=sandbox

# ── Nigeria (NG) ────────────────────────────────────────────────────
# Paystack — collection + Transfers (secret key also verifies webhooks)
PAYSTACK_PUBLIC_KEY_NG=
PAYSTACK_SECRET_KEY_NG=
# Dojah — NIN + selfie liveness
DOJAH_APP_ID_NG=
DOJAH_SECRET_KEY_NG=             # also verifies Dojah webhooks (UNVERIFIED — confirm with Dojah)
DOJAH_PUBLIC_KEY_NG=
DOJAH_WIDGET_ID_NG=
DOJAH_WEBHOOK_ALG_NG=sha256      # until Dojah confirms the webhook signature algorithm
# Termii — OTP + SMS
TERMII_API_KEY_NG=
TERMII_SENDER_ID_NG=             # ≤11 chars, must be approved by Termii
TERMII_BASE_URL_NG=https://api.ng.termii.com

# ── Saint Vincent & the Grenadines (VC) ─────────────────────────────
# Scotiabank ECom+ — hosted payment page (exact fields TBC from Scotiabank docs)
SCOTIA_ECOM_API_BASE_VC=
SCOTIA_ECOM_MERCHANT_ID_VC=
SCOTIA_ECOM_KEY_VC=
SCOTIA_ECOM_WEBHOOK_SECRET_VC=
# Bank batch payouts
PAYOUT_BATCH_FORMAT_VC=          # e.g. scotia_bulk_v1 (pending bank file spec)
PAYOUT_ORIGIN_ACCOUNT_VC=
# Sumsub — ID document + liveness
SUMSUB_APP_TOKEN_VC=
SUMSUB_SECRET_KEY_VC=
SUMSUB_WEBHOOK_SECRET_VC=
SUMSUB_LEVEL_NAME_VC=
SUMSUB_BASE_URL_VC=https://api.sumsub.com
# Twilio — SMS (Messaging Service for Option A, or Verify for Option B)
TWILIO_ACCOUNT_SID_VC=
TWILIO_AUTH_TOKEN_VC=
TWILIO_MESSAGING_SERVICE_SID_VC= # Option A (chosen): Twilio Messaging Service, starts with MG

# ── Optional ────────────────────────────────────────────────────────
SENTRY_DSN=
